# ============================================================================
# Quantara Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file - it's in .gitignore
# 
# To get started:
# 1. cp .env.example .env
# 2. Edit .env with your actual API keys
# 3. Never commit .env to version control
# ============================================================================

# ============================================================================
# REQUIRED: LLM Configuration
# ============================================================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model selection
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# ============================================================================
# OPTIONAL: Market Data APIs
# ============================================================================
# Polymarket API - Get from: https://polymarket.com/api
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_BASE_URL=https://clob.polymarket.com

# Kalshi API - Get from: https://kalshi.com/api
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here
KALSHI_BASE_URL=https://api.kalshi.com

# ============================================================================
# OPTIONAL: News & Sentiment Analysis
# ============================================================================
# Apify API - Get from: https://apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_BASE_URL=https://api.apify.com/v2

# ============================================================================
# OPTIONAL: Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/quantara
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# OPTIONAL: Redis Configuration (for caching)
# ============================================================================
# Redis connection string
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# OPTIONAL: Storage Configuration
# ============================================================================
# Checkpoint storage type: file, memory, s3
CHECKPOINT_STORAGE_TYPE=file
CHECKPOINT_STORAGE_DIR=./checkpoints
CHECKPOINT_RETENTION_HOURS=168
CHECKPOINT_COMPRESSION_ENABLED=true

# Vector store configuration
VECTOR_STORE_TYPE=pinecone
VECTOR_STORE_API_KEY=your_vector_store_api_key
VECTOR_STORE_INDEX_NAME=quantara-traders
VECTOR_STORE_DIMENSION=1536

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable specific features
ENABLE_MARKET_DISCOVERY=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_RISK_ASSESSMENT=true
ENABLE_TRADER_ANALYSIS=true
ENABLE_CONTINUOUS_MONITORING=true
ENABLE_HUMAN_IN_THE_LOOP=false
ENABLE_STREAMING_OUTPUT=true

# ============================================================================
# MONITORING & ALERTS
# ============================================================================
# Monitoring configuration
MONITORING_ENABLED=true
MONITORING_UPDATE_INTERVAL=300
MONITORING_VOLATILITY_THRESHOLD=0.15
MONITORING_SENTIMENT_THRESHOLD=0.3

# Alert configuration
ALERT_ENABLED=true
ALERT_CHANNELS=email,webhook
ALERT_EMAIL_RECIPIENTS=admin@example.com
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================
# Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Async configuration
ASYNC_WORKERS=10
ASYNC_TIMEOUT=30

# ============================================================================
# SECURITY
# ============================================================================
# Encryption
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_ALGORITHM=AES-256

# API Security
API_KEY_ROTATION_ENABLED=true
API_KEY_ROTATION_INTERVAL=2592000
TLS_ENABLED=true
TLS_MIN_VERSION=1.3

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================
# Test database (optional)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/quantara_test
TEST_REDIS_URL=redis://localhost:6379/1

# Mock data
USE_MOCK_DATA=false
MOCK_DATA_DIR=./mock_data

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# Logging
LOG_FORMAT=json
LOG_FILE=./logs/quantara.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_NAMESPACE=quantara

# Tracing
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ============================================================================
# NOTES
# ============================================================================
# 1. NEVER commit the .env file to version control
# 2. Use strong, unique values for all API keys
# 3. Rotate API keys regularly
# 4. Use different keys for development, staging, and production
# 5. Keep .env.example updated with new configuration options
# 6. Document any new environment variables you add
# 7. Use environment-specific .env files (.env.production, .env.staging)
# 8. For production, use a secrets management system (AWS Secrets Manager, etc.)
# ============================================================================
